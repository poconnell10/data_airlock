{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/pms_structural_profile.json",
  "title": "PMS Structural Profile",
  "description": "Declarative, vendor-agnostic structural contract for daily PMS file extracts and push API payloads. Consumed by the Extraction Layer Airlock shell.",
  "type": "object",
  "required": [
    "profile_id",
    "profile_version",
    "filename",
    "physical",
    "row_classification",
    "date_bounds",
    "atomic_sets",
    "structure"
  ],
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "filename": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "required_groups"],
      "properties": {
        "transport": {
          "type": "string",
          "enum": ["filename", "uri_path", "manifest"],
          "description": "Where identity tokens are sourced when landing (push APIs may omit a classic filename)."
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Python regex for basename when transport=filename. Optional for uri_path/manifest."
        },
        "uri_path_pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Python regex applied to the full POSIX path (or URI path) when transport=uri_path."
        },
        "manifest_identity": {
          "type": "object",
          "additionalProperties": false,
          "description": "Manifest/payload identity extraction for transport=manifest (e.g. Shiji/OHIP push).",
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "description": "Regex scanned against payload/manifest text; named groups supply identity tokens."
            }
          },
          "required": ["pattern"]
        },
        "required_groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true,
          "minItems": 0,
          "description": "Flexible 0..N named groups that must be present after a successful identity match."
        },
        "date_format": { "type": "string", "default": "%Y%m%d" },
        "path_glob": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "transport": { "const": "filename" } },
            "required": ["transport"]
          },
          "then": { "required": ["pattern"] }
        },
        {
          "if": {
            "properties": { "transport": { "const": "uri_path" } },
            "required": ["transport"]
          },
          "then": { "required": ["uri_path_pattern"] }
        },
        {
          "if": {
            "properties": { "transport": { "const": "manifest" } },
            "required": ["transport"]
          },
          "then": { "required": ["manifest_identity"] }
        }
      ]
    },
    "content_identity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Patterns to extract identity tokens from file content for filename/content agreement (Rule 1b).",
      "properties": {
        "property_pattern": {
          "type": "string",
          "description": "Regex with named group `property`."
        },
        "report_type_pattern": {
          "type": "string",
          "description": "Regex with named group `report_type`."
        },
        "business_date_pattern": {
          "type": "string",
          "description": "Regex with named group `business_date` (ISO or profile date_format)."
        },
        "business_date_format": {
          "type": "string",
          "default": "%Y-%m-%d"
        }
      }
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "delimiter", "line_ending", "compression"],
      "properties": {
        "encoding": { "type": "string", "minLength": 1 },
        "delimiter": { "type": "string", "minLength": 1 },
        "line_ending": {
          "type": "string",
          "enum": ["lf", "crlf", "cr", "any"]
        },
        "compression": {
          "type": "string",
          "enum": ["none", "gzip", "zip"]
        },
        "allow_bom": { "type": "boolean", "default": false },
        "min_bytes": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "row_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header_rules", "footer_rules", "ignore_rules", "reject_rules"],
      "properties": {
        "header_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/line_rule" }
        },
        "footer_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/line_rule" }
        },
        "ignore_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/line_rule" }
        },
        "reject_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/line_rule" }
        },
        "data_row_shape": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_fields": { "type": "integer", "minimum": 1 },
            "max_fields": { "type": "integer", "minimum": 1 },
            "exact_fields": { "type": "integer", "minimum": 1 }
          }
        },
        "row_count_declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern"],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "description": "Regex with named group `declared_row_count` or `declared_total`."
            },
            "compares_to": {
              "type": "string",
              "enum": ["total_read_rows", "accepted_rows"],
              "default": "total_read_rows"
            }
          }
        }
      }
    },
    "date_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_date_pattern", "date_format", "floor_date"],
      "properties": {
        "content_date_pattern": { "type": "string", "minLength": 1 },
        "date_format": { "type": "string", "minLength": 1 },
        "floor_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "allow_future": { "type": "boolean", "default": false }
      }
    },
    "atomic_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["set_id", "members", "group_by"],
        "properties": {
          "set_id": { "type": "string", "minLength": 1 },
          "members": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "group_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "applies_to_report_types": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_sections", "udf"],
      "properties": {
        "expected_sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "marker_pattern"],
            "properties": {
              "section_id": { "type": "string", "minLength": 1 },
              "marker_pattern": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean", "default": true }
            }
          }
        },
        "udf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slot_pattern", "expected_slot_count"],
          "properties": {
            "slot_pattern": { "type": "string", "minLength": 1 },
            "expected_slot_count": { "type": "integer", "minimum": 0 },
            "count_mode": {
              "type": "string",
              "enum": ["distinct_slots", "max_per_row", "total_matches"],
              "default": "distinct_slots"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "line_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "pattern"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    }
  }
}
